# correct-cn environment template.
# Copy this file to `.env` and adjust the values. Every variable is optional;
# the service falls back to safe built-in defaults when a variable is absent.
#
# 设计原则：环境变量只是一套「默认」。config.json 里写了的字段优先于环境变量；
# 只有 config.json 没写（为空/缺省）的字段，才会用环境变量兜底。所以你不用配很多
# 环境变量——review/audit 用 OLLAMA_*，final 用 FINAL_*，某个步骤要换 provider
# 就在 config.json 里显式写那一步的节点即可。
#
# 所有提示词与采样参数都在 config.json（5 个节点：corrector / sensitive /
# review / audit / final）里，不在此处。

# Directory inside the container that holds config + sensitive dictionaries.
DATA_DIR=/data

# Correction model (MacBert). Overrides config.json -> corrector.model when empty.
CORRECTOR_MODEL=shibing624/macbert4csc-base-chinese

# Correction mode: "model" (load MacBert, needs torch/transformers/pycorrector)
# or "mock" (dependency-free stand-in, ideal for local API testing).
CORRECTOR_MODE=mock

# --- LLM 环境变量（按步骤分组）----------------------------------------------
# 环境变量只是一套「默认」。config.json 里写了的字段优先于环境变量；
# 只有 config.json 没写（为空/缺省）的字段，才会用环境变量兜底。
#
# 优先级（低 → 高）：内置默认 < OLLAMA_*（review+audit）< FINAL_*（final）
# < LLM_*（legacy 兜底）。
#
# protocol: "ollama" -> 本地 Ollama 原生 /api/generate；
#           "openai" -> 任意 OpenAI 兼容 /v1/chat/completions（含 Ollama 的 /v1 接口）。

# --- OLLAMA_*：review / audit 的共享本地模型默认（Step 3 + Step 4）-----------
OLLAMA_PROTOCOL=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=300
# 外部 provider（openai 协议）的 Bearer Token；本地 Ollama 留空即可。
OLLAMA_API_KEY=

# --- FINAL_*：final 的外部模型默认（Step 5 最终修复）-------------------------
# 质量敏感，通常改用外部大模型；留空则沿用 review 的 OLLAMA_* 值。
# FINAL_PROTOCOL=openai
# FINAL_BASE_URL=https://api.deepseek.com
# FINAL_MODEL=deepseek-chat
# FINAL_API_KEY=sk-your-key

# --- LLM_*：legacy 兜底（OLLAMA_*/FINAL_* 未设时的 fallback）----------------
# 保留向后兼容；新部署建议直接用 OLLAMA_* + FINAL_*。
# LLM_PROTOCOL=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen3.5:9b
# LLM_API_KEY=

# Default source for /api/sensitive/refresh (konsheng/Sensitive-lexicon CDN).
SENSITIVE_REMOTE_BASE=https://cdn.jsdelivr.net/gh/konsheng/Sensitive-lexicon@master/Vocabulary/

# Optional: path to a custom config.json (defaults to $DATA_DIR/config.json)
# CONFIG_PATH=/data/config.json

# Optional: path to the API-key file (one key per line). When empty the API is open.
# API_KEYS_FILE=/data/.keys
